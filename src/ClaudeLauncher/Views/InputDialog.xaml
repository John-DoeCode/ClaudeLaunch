<Window x:Class="ClaudeLauncher.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Launcher"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}">

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <Grid Height="40" Background="{StaticResource BackgroundBrush}"
                  MouseLeftButtonDown="OnTitleBarDrag">
                <TextBlock x:Name="TitleText" Text="Claude Launcher" Margin="16,0,0,0"
                           VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button Style="{StaticResource CloseButton}"
                        HorizontalAlignment="Right" Click="OnCancel" />
            </Grid>

            <StackPanel Margin="20,4,20,20">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,14" />

                <TextBox x:Name="InputBox" Margin="0,0,0,16"
                         FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="14" Padding="12,11"
                         KeyDown="OnInputKeyDown" Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Annuler" Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0" Click="OnCancel" />
                    <Button x:Name="OkButton" Content="Valider" Style="{StaticResource AccentButton}"
                            Padding="20,9" Click="OnOk" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
