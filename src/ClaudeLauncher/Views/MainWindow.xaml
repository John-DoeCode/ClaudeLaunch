<Window x:Class="ClaudeLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClaudeLauncher.ViewModels"
        Title="Claude Launcher"
        Width="900"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        AllowDrop="True"
        Drop="OnDrop"
        DragOver="OnDragOver"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="{StaticResource BackgroundBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Claude Launcher" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="assistant de démarrage CLI" Style="{StaticResource CaptionText}"
                           Margin="10,1,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button Style="{StaticResource CloseButton}" Click="OnClose"
                    HorizontalAlignment="Right" ToolTip="Fermer" />
        </Grid>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="24,8,24,24">

            <TextBlock Text="Où démarrer Claude Code ?" Style="{StaticResource TitleText}" Margin="0,4,0,4" />
            <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,16"
                       Text="Sélectionnez un dossier : si aucun CLAUDE.md n'existe, il est généré depuis le modèle choisi, puis un terminal s'ouvre dans le dossier et la commande est envoyée."
                       TextWrapping="Wrap" />

            <!-- Project -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="PROJET" Style="{StaticResource SectionLabel}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding History}"
                                  SelectedItem="{Binding SelectedProject, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionText}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="620" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="1" Content="Parcourir..." Style="{StaticResource GhostButton}"
                                Command="{Binding BrowseCommand}" Margin="8,0,0,0" Height="42" />
                        <Button Grid.Column="2" Content="Explorateur" Style="{StaticResource GhostButton}"
                                Command="{Binding OpenInExplorerCommand}" Margin="8,0,0,0" Height="42" />
                        <Button Grid.Column="3" Content="Retirer" Style="{StaticResource GhostButton}"
                                Command="{Binding RemoveCommand}" Margin="8,0,0,0" Height="42"
                                ToolTip="Retirer ce dossier de l'historique" />
                    </Grid>

                    <Border Margin="0,12,0,0" CornerRadius="8" Background="#FF1F1D1B" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedPath}" FontFamily="Cascadia Mono, Consolas"
                                       FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusIsWarning}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- CLAUDE.md template -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="MODÈLE CLAUDE.md" Style="{StaticResource SectionLabel}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding Templates}"
                                  SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                                  DisplayMemberPath="Name" />

                        <Button Grid.Column="1" Content="Nouveau" Style="{StaticResource GhostButton}"
                                Command="{Binding NewTemplateCommand}" Margin="8,0,0,0" Height="42" />
                        <Button Grid.Column="2" Content="Enregistrer" Style="{StaticResource GhostButton}"
                                Command="{Binding SaveTemplateCommand}" Margin="8,0,0,0" Height="42" />
                        <Button Grid.Column="3" Content="Supprimer" Style="{StaticResource GhostButton}"
                                Command="{Binding DeleteTemplateCommand}" Margin="8,0,0,0" Height="42" />
                    </Grid>

                    <TextBox Margin="0,12,0,0" Height="150"
                             Text="{Binding TemplateContent, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

                    <TextBlock Text="{Binding TemplateStatus}" Style="{StaticResource CaptionText}"
                               Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Variables remplacées à la génération : {{PROJECT_NAME}}, {{PROJECT_PATH}}, {{DATE}}." />
                </StackPanel>
            </Border>

            <!-- Options -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="OPTIONS" Style="{StaticResource SectionLabel}" />
                    <CheckBox Content="Mode remote (contrôle à distance)"
                              IsChecked="{Binding UseRemoteMode, Mode=TwoWay}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding CommandPreview}" Style="{StaticResource CaptionText}"
                               Margin="28,0,0,0" FontFamily="Cascadia Mono, Consolas" />
                </StackPanel>
            </Border>

            <!-- Launch -->
            <Button Style="{StaticResource AccentButton}"
                    Command="{Binding LaunchCommand}"
                    Content="Lancer Claude Code"
                    Height="52" />


        </StackPanel>
    </Grid>
</Window>
